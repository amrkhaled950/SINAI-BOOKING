# Supabase Configuration for Sinai Booking
# 1. Create a free project on https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and Project API anon/public key here:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# PayTabs Payment Gateway Configuration
PAYTABS_PROFILE_ID=your-paytabs-profile-id
PAYTABS_SERVER_KEY=your-paytabs-server-key
PAYTABS_CLIENT_KEY=your-paytabs-client-key
PAYTABS_REGION=egypt
PAYTABS_BASE_URL=https://secure-egypt.paytabs.com
PAYTABS_CURRENCY=EGP
PAYTABS_USD_RATE=50
VITE_PAYTABS_ENABLED=true
